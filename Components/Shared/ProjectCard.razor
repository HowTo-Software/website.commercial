@inject IStringLocalizer<AppStrings> L
@inject ProjectBrief Brief

<article class="project-card" data-project-id="@Project.Index" data-reveal style="--reveal-delay: @(RevealDelay)ms">
    <button class="project-visual @Project.Theme" type="button" data-open-dialog="@Project.DialogId"
            aria-label="@($"{L["ViewProject"]}: {Project.Title}")" aria-haspopup="dialog" aria-controls="@Project.DialogId">
        <span class="project-visual-label">@L[Project.Status]<span>@Project.Index / HTS</span></span>
        <span class="project-mini-browser">
            <span class="mini-browser-chrome"><span aria-hidden="true">● ● ●</span><span>@Project.Domain</span></span>
            <span class="project-mini-site">
                <span class="mini-site-brand">@Project.Brand<span aria-hidden="true">↗</span></span>
                <span class="mini-site-headline">@L[Project.Headline]</span>
                @if (HasImage)
                {
                    <img src="@Project.Image" alt="@(Project.Alt is null ? Project.Title : L[Project.Alt].Value)"
                         width="1440" height="900" loading="lazy" decoding="async" @onerror="() => _imageFailed = true" />
                }
                else
                {
                    <span class="mini-site-mark" aria-hidden="true">@Project.Monogram</span>
                }
                <span class="mini-site-footer">@L["DesignDevelopment"]<span>HTS /</span></span>
            </span>
        </span>
        <span class="project-view-badge">@L["ViewProject"]<UiIcon Name="diagonal" /></span>
    </button>
    <div class="project-caption">
        <div>
            <p>@L[Project.Type]</p>
            <h3><button type="button" class="project-title-button" data-open-dialog="@Project.DialogId" aria-haspopup="dialog" aria-controls="@Project.DialogId">@Project.Title</button></h3>
        </div>
        <a class="circle-button" href="@Project.Url" target="_blank" rel="noopener noreferrer"
           aria-label="@($"{L["VisitSite"]}: {Project.Title} {L["OpensNewTab"]}")"><UiIcon Name="diagonal" /></a>
    </div>
    <dialog id="@Project.DialogId" class="project-dialog" aria-labelledby="@(Project.DialogId + "-title")">
        <div class="dialog-top"><span class="eyebrow">@L[Project.Status] / @Project.Index</span><button type="button" class="circle-button" data-close-dialog aria-label="@L["ClosePreview"]"><UiIcon Name="close" /></button></div>
        <ProjectPreview Project="Project" />
        <div class="dialog-copy">
            <p class="eyebrow">@L[Project.Type]</p>
            <h3 id="@(Project.DialogId + "-title")">@Project.Title</h3>
            <p>@L[Project.Description]</p>
            <p class="project-note">@L["ProjectHostedNotice"]</p>
            <div class="dialog-actions">
                <a href="@Project.Url" class="button button-orange" target="_blank" rel="noopener noreferrer">@L["VisitSite"] <span class="visually-hidden">@L["OpensNewTab"]</span><UiIcon Name="diagonal" /></a>
                <a href="#quote" class="animated-link" data-close-dialog @onclick="() => Brief.SelectService(Project.Service)">@L["WantSimilar"] <UiIcon Name="diagonal" /></a>
            </div>
        </div>
    </dialog>
</article>
@code {
    [Parameter, EditorRequired] public PortfolioProject Project { get; set; } = null!;
    [Parameter] public int RevealDelay { get; set; }
    private string? _image;
    private bool _imageFailed;
    private bool HasImage => !string.IsNullOrEmpty(Project.Image) && !_imageFailed;

    protected override void OnParametersSet()
    {
        if (_image == Project.Image) return;
        _image = Project.Image;
        _imageFailed = false;
    }
}

@inject IStringLocalizer<AppStrings> L

<section id="projects" class="section projects-section" aria-labelledby="projects-heading">
    <div class="container">
        <div class="section-heading split-heading">
            <div><p class="eyebrow"><span class="section-number">01</span>@L["ProjectsEyebrow"]</p><h2 id="projects-heading"><MaskReveal>@L["ProjectsTitle"]</MaskReveal><MaskReveal Delay="70"><span class="muted-heading">@L["ProjectsTitleSecond"]<span class="project-heading-period">.</span></span></MaskReveal></h2></div>
            <p class="heading-aside" data-reveal>@L["ProjectsIntro"]</p>
        </div>
        <div class="project-filters" data-reveal role="group" aria-label="@L["FilterProjects"]">
            @foreach (var filter in Filters.Where(item => item.Value == "all" || Projects.Any(project => project.Category == item.Value)))
            {
                <button type="button" data-project-filter="@filter.Value" class="@(_filter == filter.Value ? "is-active" : "")" aria-pressed="@(_filter == filter.Value ? "true" : "false")" @onclick="() => SelectFilter(filter.Value)">@L[filter.Label]<span>@Projects.Count(p => filter.Value == "all" || p.Category == filter.Value).ToString("00", CultureInfo.InvariantCulture)</span></button>
            }
            <span class="filter-caption">@L["SelectedWork"] / 2026</span>
        </div>
        <div class="projects-grid" aria-live="polite" aria-atomic="false">
            @foreach (var project in _visibleProjects)
            {
                <ProjectCard @key="(project.Index, _filter)" Project="project" RevealDelay="@((int.Parse(project.Index, CultureInfo.InvariantCulture) - 1) % 2 * 90)" />
            }
        </div>
        <div class="projects-bottom" data-reveal><span>@L["ProjectsBottom"]</span><a class="animated-link" href="#quote">@L["CreateYours"] <UiIcon Name="diagonal" /></a></div>
    </div>
</section>
@code {
    private string _filter = "all";
    private PortfolioProject[] _visibleProjects = Projects;
    private static readonly (string Value, string Label)[] Filters = [("all", "FilterAll"), ("platform", "FilterPlatforms"), ("commerce", "FilterCommerce"), ("community", "FilterCommunities")];

    // Preserve the existing live-project catalog; unavailable screenshots use honest brand previews.
    private static readonly PortfolioProject[] Projects = [
        new("01", "HowToSoftware", "howtosoftware", "https://howtoosoftware.com/", "images/project-howtoosoftware.webp", "ProjectHowtoAlt", "hts",
            "ProjectTypePublishing", "ProjectHowtoDescription", "ProjectHowtoHeadline", "ProjectStatusLive", "theme-violet", "platform", "custom"),
        new("02", "HTS Game Hosting", "HTS / GAMES", "https://host.howto.software/", "images/project-hts-hosting.webp", "ProjectHostingAlt", "HTS",
            "ProjectTypeHosting", "ProjectHostingDescription", "ProjectHostingHeadline", "ProjectStatusLive", "theme-night", "commerce", "custom"),
        new("03", "Mark's Baseball Cards", "mark's", "https://marks-baseballcards.com/", "images/project-marks-baseball-cards.webp", "ProjectMarksAlt", "’91",
            "ProjectTypeCollection", "ProjectMarksDescription", "ProjectMarksHeadline", "ProjectStatusLive", "theme-cards", "commerce", "website"),
        new("05", "Linktura", "linktura", "https://linktura.org/", null, null, "L",
            "ProjectTypeAffiliate", "ProjectLinkturaDescription", "ProjectLinkturaHeadline", "ProjectStatusSignIn", "theme-teal", "platform", "custom")
    ];

    private void SelectFilter(string filter)
    {
        if (!Filters.Any(item => item.Value == filter) || (filter != "all" && !Projects.Any(project => project.Category == filter))) return;
        _filter = filter;
        _visibleProjects = Projects.Where(project => filter == "all" || project.Category == filter).ToArray();
    }
}
